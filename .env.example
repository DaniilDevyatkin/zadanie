# Скопируй в .env и поправь под себя:  cp .env.example .env
# Файл .env в репозиторий не попадает (см. .gitignore).

# Стартовый пароль администратора. Действует ТОЛЬКО при первом запуске, пока
# нет файла data/admin.json. Потом меняется командой:
#   docker compose exec zadanie python admin_passwd.py
ADMIN_PASSWORD=koleso123

# Куда открывать порт: 0.0.0.0 — наружу, 127.0.0.1 — только через nginx/Caddy
APP_BIND=0.0.0.0

# Кому доверять заголовки X-Forwarded-* (IP обратного прокси).
# Если прокси нет или он на другом хосте — оставь *
FORWARDED_ALLOW_IPS=*
